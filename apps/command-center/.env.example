# Supabase (optional). Without these, the app runs in local demo mode with seed data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret for seed/admin scripts. Never exposed to the browser.
SUPABASE_SECRET_KEY=

# Demo operator token used to authorize the protected state API in demo mode.
# Server-only. Never rendered in the UI, logs, or exports.
# In production (Render), set this as a SECRET env var in the dashboard — do not
# commit a real value here or in render.yaml.
DEMO_OPERATOR_TOKEN=demo-operator-local

# Production runtime flag. Render sets this to "production" (see render.yaml).
NODE_ENV=development
